<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Overrides Directory.Build.props to add netstandard2.0, which brings
         .NET Framework 4.6.2+ consumers along. Closes kylegregory/EmmaSharp#44. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <!-- netstandard2.0 defaults to C# 7.3, which cannot parse <Nullable>enable</Nullable>.
         Pinned only for that TFM; the modern targets keep the SDK default. -->
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.0'">12</LangVersion>
    <AssemblyName>EmmaSharper</AssemblyName>
    <PackageId>EmmaSharper</PackageId>
    <Version>8.0.1</Version>
    <Description>A .NET wrapper for the Emma (Marigold) API - https://api.myemma.com/</Description>
    <PackageTags>emma;marigold;email;marketing;api;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The public surface is not fully documented yet; tracked separately.
         Suppressed rather than disabling doc generation, so XML docs still ship. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <!-- Placeholder mark, not branding. nuget.org wants PNG or JPEG at 128x128. -->
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Per-TFM so a net10 consumer never has Extensions 8.x dragged in transitively.
       Central Package Management was considered and skipped: with two projects and
       genuinely per-TFM versions, conditional PackageVersion items add more friction
       than they remove. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="[8.0.0,9.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="[10.0.0,11.0.0)" />
  </ItemGroup>

  <!-- netstandard2.0 has none of this in-box, so the packages are explicit here only.
       System.Text.Json's package backports JsonNamingPolicy.SnakeCaseLower,
       Utf8JsonWriter.WriteRawValue and JsonConverterFactory, all of which this library uses. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="System.Text.Json" Version="[8.0.5,9.0.0)" />
  </ItemGroup>

  <!-- System.Text.Json is in-box for net8.0+ - deliberately not referenced there, so the
       consumer's runtime version wins. RestSharp and Newtonsoft.Json are gone as of 8.0.0. -->

</Project>
