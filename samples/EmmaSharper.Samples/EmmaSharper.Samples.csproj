<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single framework: this is a demonstration host, not a shipped artefact. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>EmmaSharper.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
    <UserSecretsId>emmasharper-samples</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Present so the resilience sample is compiled, not just described. It is net8.0+ only,
         which is why the library itself does not take this dependency. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmmaSharper\EmmaSharper.csproj" />
  </ItemGroup>

</Project>
